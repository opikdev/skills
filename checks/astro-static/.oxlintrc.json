{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["import", "typescript", "unicorn"],
  "ignorePatterns": ["dist/**", ".astro/**", ".wrangler/**", ".lighthouseci/**"],
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@fontsource-variable/*"]
      }
    ]
  }
}
